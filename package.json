    "check": "biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "typescript": "6.0.3",
    "wxt": "0.21.4"
  }
}
