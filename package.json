{
  "name": "asterveil",
  "version": "0.1.0",
  "private": true,
  "description": "Modular visual and interaction enhancements for 7FA4.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
