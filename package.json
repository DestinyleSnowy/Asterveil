{
  "name": "asterveil",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "The next generation of Better Names.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "npm run build:full",
    "build:light": "wxt build --mode light",
    "build:full": "wxt build --mode full",
    "build:all": "npm run build:light && npm run build:full",
    "zip": "npm run zip:all",
    "zip:light": "wxt zip --mode light",
    "zip:full": "wxt zip --mode full",
    "zip:all": "npm run zip:light && npm run zip:full",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:user-names:browser": "npm run build:all && node tests/user-names.browser.mjs",
    "test:problem-copy:browser": "npm run build:all && node tests/problem-copy.browser.mjs",
    "update:user-names": "node build/update-user-names.mjs",
    "encrypt:user-names": "node build/encrypt-user-names.mjs",
    "test:homework:browser": "node tests/homework.browser.mjs",
    "test:homework-export:browser": "npm run build:all && node tests/homework-export.browser.mjs",
    "test:updater:browser": "node updater/scripts/browser-smoke.mjs light && node updater/scripts/browser-smoke.mjs full",
    "check": "biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.4",
    "linkedom": "0.18.13",
    "playwright": "1.61.0",
    "typescript": "6.0.3",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "html-to-image": "^1.11.13",
    "katex": "^0.18.9",
    "marked": "^18.0.14",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  }
}
