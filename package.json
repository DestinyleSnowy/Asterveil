{
  "name": "asterveil",
  "version": "0.1.2",
  "private": true,
  "license": "Apache-2.0",
  "description": "The next generation of Better Names.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "npm run build:full",
    "build:light": "wxt build --mode light",
    "build:full": "wxt build --mode full",
    "build:all": "npm run build:light && npm run build:full",
    "zip": "npm run zip:all",
    "zip:light": "wxt zip --mode light",
    "zip:full": "wxt zip --mode full",
    "zip:all": "npm run zip:light && npm run zip:full",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "check": "biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.4",
    "linkedom": "0.18.13",
    "typescript": "6.0.3",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "html-to-image": "^1.11.13",
    "katex": "^0.18.9",
    "marked": "^18.0.14",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  }
}
